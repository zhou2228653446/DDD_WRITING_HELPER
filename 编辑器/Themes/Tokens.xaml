<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ============================================================================
        设计 Token（Design Tokens）
        ============================================================================
        1) 颜色 token —— 全部是 DynamicResource 引用目标，运行时由
           MainWindow.ApplyAppearance() 写入 Application.Current.Resources 顶层覆写。
           默认值 = 内置预设 "default-white"，未加载配置时也能正常显示。
        2) 尺寸 token —— 静态，不随主题切换，用 StaticResource 引用。
        3) 控件样式 —— 统一圆角 / 内边距 / 悬浮过渡，供各 XAML 复用。
        ============================================================================
    -->

    <!-- ==================== 1. 颜色 Token ==================== -->

    <!--
        背景层：这里的纯色只是"尚未 Apply 主题"时的兜底默认值。
        真实运行时由 ThemeTokens.Apply() 写成 Textured() 合成画刷
        （主题纯色 + 纸纹颗粒，128/256px 平铺），因此各区域都有纸张质地。
    -->
    <SolidColorBrush x:Key="Brush.Surface"     Color="#EBE6DC"/>
    <SolidColorBrush x:Key="Brush.Panel"       Color="#F8F5EE"/>
    <SolidColorBrush x:Key="Brush.Editor"      Color="#FDFBF6"/>
    <SolidColorBrush x:Key="Brush.Menu"        Color="#F4F0E7"/>
    <SolidColorBrush x:Key="Brush.StatusBar"   Color="#E7E1D6"/>
    <SolidColorBrush x:Key="Brush.HeaderBg"    Color="#F4F0E7"/>
    <SolidColorBrush x:Key="Brush.SubtleBg"    Color="#F4F0E7"/>
    <SolidColorBrush x:Key="Brush.InputBg"     Color="#F8F5EE"/>

    <!-- 线与描边 -->
    <SolidColorBrush x:Key="Brush.Border"      Color="#DCD3C6"/>
    <SolidColorBrush x:Key="Brush.Divider"     Color="#DCD3C6"/>
    <SolidColorBrush x:Key="Brush.Splitter"    Color="#D8CFC1"/>

    <!-- 文字：暖调深灰，不用纯黑 -->
    <SolidColorBrush x:Key="Brush.Text"        Color="#33302A"/>
    <SolidColorBrush x:Key="Brush.TextMuted"   Color="#7C7468"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FBFAF6"/>

    <!-- 强调：雾面低饱和 -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#4A729C"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#456B92"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#406585"/>

    <!-- 状态 -->
    <SolidColorBrush x:Key="Brush.Hover"       Color="#126B5539"/>
    <SolidColorBrush x:Key="Brush.Selected"    Color="#1C4A729C"/>
    <SolidColorBrush x:Key="Brush.Danger"      Color="#C2605C"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#B45955"/>
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#A85551"/>
    <SolidColorBrush x:Key="Brush.Success"     Color="#5F8F62"/>

    <!--
        柔光层：透明占位，真实值由 ThemeTokens.Apply() 写入
        （左上→右下的极淡 LinearGradientBrush，模拟纸张受光不均）。
        纸纹不单列 token —— 它由 ThemeTokens.Textured() 直接合成进各背景画刷。
    -->
    <SolidColorBrush x:Key="Brush.Sheen"       Color="Transparent"/>

    <!-- ==================== 2. 尺寸 Token ==================== -->

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">14</sys:Double>
    <sys:Double x:Key="FontSize.Title">16</sys:Double>
    <sys:Double x:Key="FontSize.Display">26</sys:Double>

    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">10</CornerRadius>

    <Thickness x:Key="Pad.Xs">4</Thickness>
    <Thickness x:Key="Pad.Sm">8</Thickness>
    <Thickness x:Key="Pad.Md">12</Thickness>
    <Thickness x:Key="Pad.Lg">16</Thickness>

    <sys:Double x:Key="Height.Control">30</sys:Double>
    <sys:Double x:Key="Height.Row">30</sys:Double>

    <!-- 矢量图标字体：Win11 优先 Fluent Icons，回退 Win10 的 MDL2 Assets -->
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI, SimSun</FontFamily>

    <!-- ==================== 3. 动效 Token ====================

        分三档，按"动作是否属于内容登场"来选：
          · Tap / Fast（80~140ms）—— 微交互。按下去必须立刻有反馈，慢了就是拖沓。
          · Normal（200ms）—— 淡出、按钮回弹这类收尾动作。
          · Pop（320ms）—— 弹出 / 卷轴展开。这是"内容登场"，
            要给"从顶端铺开"的动作留出可感知的时间；太快会显得"啪"地弹出来，反而突兀。
        缓动一律 EaseOut —— 起步快、收尾稳，符合"界面立即响应"的心理预期。
    -->

    <Duration x:Key="Anim.Duration.Tap">0:0:0.08</Duration>
    <Duration x:Key="Anim.Duration.Fast">0:0:0.14</Duration>
    <Duration x:Key="Anim.Duration.Normal">0:0:0.20</Duration>
    <Duration x:Key="Anim.Duration.Slow">0:0:0.26</Duration>
    <!-- 弹出 / 卷轴展开（与 Motion.cs 的 DurPop 保持一致） -->
    <Duration x:Key="Anim.Duration.Pop">0:0:0.32</Duration>

    <CubicEase x:Key="Anim.Ease.Out" EasingMode="EaseOut"/>
    <CubicEase x:Key="Anim.Ease.InOut" EasingMode="EaseInOut"/>
    <!-- 弹出用：轻微回弹，收尾多一点"落位感" -->
    <BackEase x:Key="Anim.Ease.Pop" EasingMode="EaseOut" Amplitude="0.28"/>

    <!-- ==================== 4. 通用样式 ==================== -->

    <!-- 图标字形（配合 Font.Icon 使用，直接写 &#xE7xx; 码点） -->
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>

    <!-- 分区小标题 -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ========== 按钮：图标按钮（工具栏） ==========

         动效结构说明（其余按钮样式同构）：
           Root  —— 承载按下缩放（只动 RenderTransform，不触发布局重算）
           Bd    —— 静态底色
           Hover —— 悬浮蒙层，用 Opacity 0→1 做「颜色过渡」
                    （不能直接给共享的 Brush.* 做 ColorAnimation，
                      那会把全局所有引用同一画刷的地方一起改掉）
           ContentPresenter 放最上层，避免文字被蒙层染色
    -->
    <Style x:Key="Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Md}"/>
                    <Border x:Name="Hover" Background="{DynamicResource Brush.Hover}"
                            CornerRadius="{StaticResource Radius.Md}" Opacity="0"/>
                    <Border x:Name="Press" Background="{DynamicResource Brush.Selected}"
                            CornerRadius="{StaticResource Radius.Md}" Opacity="0"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Anim.Duration.Fast}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Anim.Duration.Tap}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.96" Duration="{StaticResource Anim.Duration.Tap}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.96" Duration="{StaticResource Anim.Duration.Tap}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="{StaticResource Anim.Duration.Normal}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Pop}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Pop}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.35"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 按钮：主操作（accent 实心） ========== -->
    <Style x:Key="Btn.Primary" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Border x:Name="Bd" Background="{DynamicResource Brush.Accent}"
                            CornerRadius="{StaticResource Radius.Md}"/>
                    <Border x:Name="Hover" Background="{DynamicResource Brush.AccentHover}"
                            CornerRadius="{StaticResource Radius.Md}" Opacity="0"/>
                    <Border x:Name="Press" Background="{DynamicResource Brush.AccentPressed}"
                            CornerRadius="{StaticResource Radius.Md}" Opacity="0"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Anim.Duration.Fast}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Anim.Duration.Tap}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.97" Duration="{StaticResource Anim.Duration.Tap}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.97" Duration="{StaticResource Anim.Duration.Tap}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="{StaticResource Anim.Duration.Normal}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Pop}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Pop}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 按钮：次要操作（描边 ghost） ========== -->
    <Style x:Key="Btn.Ghost" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Height.Control}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform/>
                    </Grid.RenderTransform>
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"/>
                    <Border x:Name="Hover" Background="{DynamicResource Brush.Hover}"
                            CornerRadius="{StaticResource Radius.Md}" Opacity="0"/>
                    <!-- 描边单独一层：边框色也走淡入，避免"底色渐变、边框瞬变"的割裂 -->
                    <Border x:Name="HoverEdge" Background="Transparent"
                            BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}" Opacity="0"/>
                    <Border x:Name="Press" Background="{DynamicResource Brush.Selected}"
                            CornerRadius="{StaticResource Radius.Md}" Opacity="0"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Anim.Duration.Fast}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverEdge"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Anim.Duration.Fast}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverEdge"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="{StaticResource Anim.Duration.Tap}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.97" Duration="{StaticResource Anim.Duration.Tap}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.97" Duration="{StaticResource Anim.Duration.Tap}"
                                                     EasingFunction="{StaticResource Anim.Ease.Out}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="{StaticResource Anim.Duration.Normal}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Pop}"/>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="{StaticResource Anim.Duration.Normal}"
                                                     EasingFunction="{StaticResource Anim.Ease.Pop}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 按钮：小号 chip（替代等宽 75px 网格） ========== -->
    <Style x:Key="Btn.Chip" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
