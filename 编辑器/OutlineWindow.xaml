<hc:Window x:Class="编辑器.OutlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="大纲" Height="680" Width="960" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Padding="18,14,18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="{StaticResource FontSize.Title}"
                           FontWeight="SemiBold" Text="大纲"/>
                <TextBlock Text="一本书写到几十章之后，最需要的不是再多一个 AI 按钮，而是能一眼看清结构：哪章还没写、哪章缺梗概、顺序对不对。双击卡片直接跳到那一章。"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 统计与过滤 -->
        <Border Grid.Row="1" Padding="18,10"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="StatsText" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="只看" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <ComboBox x:Name="FilterBox" Width="130"
                              FontSize="{StaticResource FontSize.Small}"
                              SelectionChanged="FilterBox_SelectionChanged">
                        <ComboBoxItem Content="全部章节" IsSelected="True"/>
                        <ComboBoxItem Content="还没写的"/>
                        <ComboBoxItem Content="缺梗概的"/>
                        <ComboBoxItem Content="已写完的"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 卡片网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <ItemsControl x:Name="CardList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="278" Margin="0,0,12,12" Padding="12,10"
                                Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Md}"
                                MouseLeftButtonUp="Card_MouseLeftButtonUp">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开这一章" Click="OpenChapter_Click"/>
                                    <MenuItem Header="改名" Click="RenameChapter_Click"/>
                                    <MenuItem Header="写梗概" Click="EditSummary_Click"/>
                                    <Separator/>
                                    <MenuItem Header="上移" Click="MoveUp_Click"/>
                                    <MenuItem Header="下移" Click="MoveDown_Click"/>
                                    <Separator/>
                                    <MenuItem Header="删除这一章" Click="DeleteChapter_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding StateBrush}"
                                                 ToolTip="{Binding StateText}"/>
                                        <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSize.Small}"/>
                                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding WordsText}"
                                               FontSize="{StaticResource FontSize.Caption}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </Grid>
                                <TextBlock Text="{Binding SummaryText}" Margin="15,7,0,0"
                                           FontSize="{StaticResource FontSize.Small}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap" MaxHeight="42"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部 -->
        <Border Grid.Row="3" Padding="18,10,18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="HintText" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="右键卡片可改名、写梗概、上下移动、删除"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Ghost}" Content="新建章节" Click="NewChapter_Click"/>
                    <Button Style="{StaticResource Btn.Ghost}" Content="刷新" Margin="6,0,0,0"
                            Click="Refresh_Click"/>
                    <Button Style="{StaticResource Btn.Primary}" Content="关闭" Margin="6,0,0,0"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
