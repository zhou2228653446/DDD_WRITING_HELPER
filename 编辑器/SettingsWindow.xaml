<hc:Window x:Class="编辑器.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="设定" Height="640" Width="920" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 头部 ==================== -->
        <Border Grid.Row="0" Padding="18,14,18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="设定" FontSize="{StaticResource FontSize.Title}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="贯穿全书的设定集中在这里。AI 每次生成都会读取它们，也可以让 AI 直接写入。"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ==================== 主体：左导航 + 右编辑区 ==================== -->
        <Grid Grid.Row="1" Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SectionList" Grid.Column="0"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource ListBoxItem.Card}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="SectionList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Hint}" Margin="0,2,0,0"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Margin="14,0,0,0"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Md}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,12,14,0">
                        <TextBlock x:Name="SectionTitleText" Text="全文大纲"
                                   FontSize="{StaticResource FontSize.Subtitle}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SectionHintText" TextWrapping="Wrap" Margin="0,3,0,0"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>

                    <!--
                        多行编辑框必须显式 VerticalContentAlignment="Top"：
                        HandyControl 的隐式 TextBox 样式把内容对齐设成了 Center，
                        不覆盖的话整段文字会飘在编辑框垂直中央。
                    -->
                    <TextBox x:Name="ContentBox" Grid.Row="1" Margin="14,10,14,0"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Padding="10" FontSize="14"
                             BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                             Background="{DynamicResource Brush.InputBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             SelectionBrush="{DynamicResource Brush.Accent}"
                             TextChanged="ContentBox_TextChanged"/>

                    <Grid Grid.Row="2" Margin="14,10,14,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="GenWithAiBtn" Style="{StaticResource Btn.Primary}"
                                    Content="AI 生成 / 完善" Click="GenWithAi_Click"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="清空" Margin="8,0,0,0"
                                    Click="Clear_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="CharCountText" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 底部 ==================== -->
        <Border Grid.Row="2" Padding="18,10" Margin="0,14,0,0"
                Background="{DynamicResource Brush.StatusBar}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="编辑内容会立即同步到项目，保存项目即可写入文件。"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="关闭"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
