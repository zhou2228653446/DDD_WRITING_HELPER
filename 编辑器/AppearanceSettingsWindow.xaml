<hc:Window x:Class="编辑器.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="外观设置" Height="420" Width="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" SizeToContent="Height"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主题预设 -->
        <GroupBox Grid.Row="0" Header="主题预设" Margin="0,0,0,12" Padding="8">
            <ListBox x:Name="PresetListBox" Height="112"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     SelectionChanged="PresetListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="0,0,0,4"
                                Background="{DynamicResource Brush.Panel}"
                                CornerRadius="{StaticResource Radius.Md}" BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 色块预览：面板底 / 编辑区 / 强调色 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="3"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0.5"
                                            Background="{Binding PanelBgBrush}"
                                            ToolTip="面板底色"/>
                                    <Border Width="22" Height="22" CornerRadius="3" Margin="4,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0.5"
                                            Background="{Binding EditorBgBrush}"
                                            ToolTip="编辑区背景"/>
                                    <Border Width="22" Height="22" CornerRadius="3" Margin="4,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0.5"
                                            Background="{Binding AccentColorBrush}"
                                            ToolTip="强调色"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                               FontSize="{StaticResource FontSize.Subtitle}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- 自定义背景图片 -->
        <GroupBox Grid.Row="1" Header="自定义背景图片" Margin="0,0,0,12" Padding="8">
            <StackPanel>
                <CheckBox x:Name="EnableBgCheckBox" Content="启用自定义图片作为窗口背景"
                          FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8"
                          Checked="EnableBg_Changed" Unchecked="EnableBg_Changed"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <hc:TextBox x:Name="BgPathTextBox" Grid.Column="0"
                             FontSize="{StaticResource FontSize.Small}" Padding="6" IsReadOnly="True"
                             Background="{DynamicResource Brush.SubtleBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.Border}"/>
                    <Button Grid.Column="1" x:Name="BrowseBgBtn" Style="{StaticResource Btn.Ghost}"
                            Content="浏览..." Margin="6,0,0,0"
                            Click="BrowseBg_Click"/>
                </Grid>
                <Button x:Name="RemoveBgBtn" Style="{StaticResource Btn.Ghost}"
                        Content="移除背景图片" HorizontalAlignment="Left" IsEnabled="False"
                        Click="RemoveBg_Click"/>
                <TextBlock Text="注意：编辑区域将保持浅色背景以保证可读性"
                           FontSize="{StaticResource FontSize.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 提示 -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.SubtleBg}"
                CornerRadius="{StaticResource Radius.Md}" Padding="10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <TextBlock Text="背景图片仅作为窗口氛围装饰，不会影响编辑区可读性。您随时可以切换回纯色主题。"
                       TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}"/>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{StaticResource Btn.Primary}" Width="84"
                    Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="取消" Style="{StaticResource Btn.Ghost}" Width="84"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</hc:Window>
