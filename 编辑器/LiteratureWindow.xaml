<hc:Window x:Class="编辑器.LiteratureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="参考文献库" Height="620" Width="940" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 在线检索面板（论文方案下可用） ==================== -->
        <Border x:Name="SearchPanel" Grid.Row="1" Padding="18,10,18,12" Visibility="Collapsed"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Padding="8,5" KeyDown="SearchBox_KeyDown"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                             Background="{DynamicResource Brush.InputBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             SelectionBrush="{DynamicResource Brush.Accent}"/>
                    <ComboBox x:Name="SourceCombo" Grid.Column="2" VerticalContentAlignment="Center"
                              SelectedIndex="0"/>
                    <Button x:Name="SearchBtn" Grid.Column="3" Style="{StaticResource Btn.Primary}"
                            Content="搜索" Margin="10,0,0,0" Click="Search_Click"/>
                </Grid>
                <ListBox x:Name="SearchResultsList" Height="180" Margin="0,10,0,0" Visibility="Collapsed"
                         Background="{DynamicResource Brush.Panel}"
                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                         SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sub}" Margin="0,2,0,0"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid x:Name="SearchActionRow" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SearchStatusText" Grid.Column="0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ImportSelectedBtn" Style="{StaticResource Btn.Primary}"
                                Content="导入选中" Click="ImportSelected_Click"/>
                        <Button x:Name="CloseSearchBtn" Style="{StaticResource Btn.Ghost}" Content="收起" Margin="6,0,0,0"
                                Click="SearchToggle_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 头部：说明 + 工具按钮 ==================== -->
        <Border Grid.Row="0" Padding="18,14,18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="参考文献库" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="在这里维护你的文献：手动添加、导入 BibTeX，或在论文方案下用「在线检索」。AI 生成正文时会把整个库当上下文，引用处标 [n]；库里没有的文献 AI 只写【需引文献】占位，不会编造。"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button x:Name="AddBtn" Style="{StaticResource Btn.Ghost}" Content="新增" Click="Add_Click"/>
                    <Button x:Name="ImportBtn" Style="{StaticResource Btn.Ghost}" Content="导入 BibTeX" Margin="6,0,0,0"
                            Click="Import_Click" ToolTip="选择 .bib / .txt 文件，可多选；导入后自动编号入库"/>
                    <Button x:Name="SearchToggleBtn" Style="{StaticResource Btn.Ghost}" Content="在线检索" Margin="6,0,0,0"
                            Click="SearchToggle_Click" ToolTip="在 OpenAlex / Semantic Scholar 检索文献，勾选后导入文献库"/>
                    <Button x:Name="DeleteBtn" Style="{StaticResource Btn.Ghost}" Content="删除" Margin="6,0,0,0"
                            Click="Delete_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体：左列表 + 右表单 ==================== -->
        <Grid Grid.Row="2" Margin="18,12,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="EntryList" Grid.Column="0"
                     Background="{DynamicResource Brush.Panel}"
                     BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                     SelectionChanged="EntryList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Sub}" Margin="0,2,0,0"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel" IsEnabled="False" Margin="4,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="标题 *" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBox x:Name="TitleBox" Margin="0,4,0,0" Padding="8,5" TextChanged="Field_TextChanged"
                                     BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                     Background="{DynamicResource Brush.InputBg}"
                                     Foreground="{DynamicResource Brush.Text}"
                                     CaretBrush="{DynamicResource Brush.Text}"
                                     SelectionBrush="{DynamicResource Brush.Accent}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="年份" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBox x:Name="YearBox" Margin="0,4,0,0" Padding="8,5" TextChanged="Field_TextChanged"
                                     BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                     Background="{DynamicResource Brush.InputBg}"
                                     Foreground="{DynamicResource Brush.Text}"
                                     CaretBrush="{DynamicResource Brush.Text}"
                                     SelectionBrush="{DynamicResource Brush.Accent}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="作者（多人用逗号分隔）" FontSize="{StaticResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0"/>
                    <TextBox x:Name="AuthorsBox" Padding="8,5" TextChanged="Field_TextChanged"
                             BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                             Background="{DynamicResource Brush.InputBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             SelectionBrush="{DynamicResource Brush.Accent}"/>

                    <TextBlock Text="来源（期刊 / 会议 / 出版社）" FontSize="{StaticResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0"/>
                    <TextBox x:Name="VenueBox" Padding="8,5" TextChanged="Field_TextChanged"
                             BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                             Background="{DynamicResource Brush.InputBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             SelectionBrush="{DynamicResource Brush.Accent}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DOI" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBox x:Name="DoiBox" Padding="8,5" TextChanged="Field_TextChanged"
                                     BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                     Background="{DynamicResource Brush.InputBg}"
                                     Foreground="{DynamicResource Brush.Text}"
                                     CaretBrush="{DynamicResource Brush.Text}"
                                     SelectionBrush="{DynamicResource Brush.Accent}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="链接（无 DOI 时备用）" FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBox x:Name="UrlBox" Padding="8,5" TextChanged="Field_TextChanged"
                                     BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                     Background="{DynamicResource Brush.InputBg}"
                                     Foreground="{DynamicResource Brush.Text}"
                                     CaretBrush="{DynamicResource Brush.Text}"
                                     SelectionBrush="{DynamicResource Brush.Accent}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="摘要" FontSize="{StaticResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0"/>
                    <TextBox x:Name="AbstractBox" Padding="8,5" AcceptsReturn="True" TextChanged="Field_TextChanged"
                             Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                             Background="{DynamicResource Brush.InputBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             SelectionBrush="{DynamicResource Brush.Accent}"/>

                    <TextBlock Text="备注" FontSize="{StaticResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,10,0,0"/>
                    <TextBox x:Name="NoteBox" Padding="8,5" TextChanged="Field_TextChanged"
                             BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                             Background="{DynamicResource Brush.InputBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Text}"
                             SelectionBrush="{DynamicResource Brush.Accent}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 底部：引用提示 + 复制文献表 ==================== -->
        <Border Grid.Row="3" Padding="18,10,18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" Grid.Column="0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextWrapping="Wrap"/>
                <Button x:Name="CopyListBtn" Grid.Column="1" Style="{StaticResource Btn.Primary}"
                        Content="复制参考文献表" Click="CopyList_Click"
                        ToolTip="按 GB/T 7714 简化格式生成 [1]..[n] 参考文献表并复制到剪贴板"/>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
