<hc:Window x:Class="编辑器.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="查找替换" Height="620" Width="780" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,14,18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="查找替换" FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold"/>
                <TextBlock Text="全书范围内查找（改人名、查伏笔埋在哪几章最常用）。双击结果跳到那一处并选中。替换会直接改写正文——写盘前会自动存快照，改错了去「版本历史」回退。"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="查找" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="FindBox" Padding="8,6"
                         Background="{DynamicResource Brush.InputBg}"
                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                         Foreground="{DynamicResource Brush.Text}"
                         CaretBrush="{DynamicResource Brush.Text}"
                         FontSize="{StaticResource FontSize.Body}"
                         KeyDown="FindBox_KeyDown"/>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Btn.Primary}"
                        Content="查找" Margin="8,0,0,0" MinWidth="72" Click="Find_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="替换为" VerticalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{DynamicResource Brush.Text}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ReplaceBox" Padding="8,6" Margin="0,8,0,0"
                         Background="{DynamicResource Brush.InputBg}"
                         BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                         Foreground="{DynamicResource Brush.Text}"
                         CaretBrush="{DynamicResource Brush.Text}"
                         FontSize="{StaticResource FontSize.Body}"/>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,8,0,0">
                    <Button Style="{StaticResource Btn.Ghost}" Content="替换选中" Click="ReplaceOne_Click"/>
                    <Button Style="{StaticResource Btn.Ghost}" Content="全部替换" Margin="6,0,0,0"
                            Click="ReplaceAll_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <RadioButton x:Name="ScopeBookRadio" Content="全书" GroupName="Scope" IsChecked="True"
                                 Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                                 Checked="Scope_Changed"/>
                    <RadioButton x:Name="ScopeChapterRadio" Content="只查当前章" GroupName="Scope"
                                 Margin="16,0,0,0" Foreground="{DynamicResource Brush.Text}"
                                 VerticalAlignment="Center" Checked="Scope_Changed"/>
                    <CheckBox x:Name="CaseSensitiveBox" Content="区分大小写" Margin="22,0,0,0"
                              Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                              Checked="Scope_Changed" Unchecked="Scope_Changed"/>
                    <TextBlock x:Name="ScopeHintText" Margin="22,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox Grid.Row="2" x:Name="ResultList" Margin="14,12,14,0"
                 Background="{DynamicResource Brush.Panel}"
                 BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ResultList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Location}" FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Padding="18,10,18,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Ghost}" Content="关闭" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
