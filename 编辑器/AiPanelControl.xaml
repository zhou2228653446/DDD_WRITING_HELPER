<UserControl x:Class="编辑器.AiPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AI助手" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="DetachBtn" Grid.Column="1" Content="📌 弹出" FontSize="12"
                        Padding="6,2" ToolTip="将AI面板分离为独立窗口"
                        Click="DetachBtn_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <!-- 功能按钮 -->
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="续写" Click="ContinueWriting_Click"
                            Width="75" Margin="0,0,4,4" Padding="6"/>
                    <Button Content="润色" Click="PolishText_Click"
                            Width="75" Margin="0,0,4,4" Padding="6"/>
                    <Button Content="人名生成" Click="GenerateName_Click"
                            Width="75" Margin="0,0,4,4" Padding="6"/>
                    <Button Content="万能聊天" Click="Chat_Click"
                            Width="75" Margin="0,0,4,4" Padding="6"/>
                </WrapPanel>

                <!-- 快速生成上下文 -->
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="全文大纲" Click="GenOutline_Click"
                            Width="75" Margin="0,0,4,4" Padding="6" FontSize="12"/>
                    <Button Content="章节大纲" Click="GenChapterOutline_Click"
                            Width="75" Margin="0,0,4,4" Padding="6" FontSize="12"/>
                    <Button Content="生成人物" Click="GenCharacter_Click"
                            Width="75" Margin="0,0,4,4" Padding="6" FontSize="12"/>
                    <Button Content="生成背景" Click="GenBackground_Click"
                            Width="75" Padding="6" FontSize="12"/>
                </WrapPanel>

                <!-- 润色风格（可开关、可自定义） -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <CheckBox x:Name="PolishStyleToggle" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="润色风格:" VerticalAlignment="Center" FontSize="13" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PolishStyleCombo" Width="110" FontSize="13"
                              SelectionChanged="PolishStyleCombo_SelectionChanged"
                              IsEnabled="{Binding IsChecked, ElementName=PolishStyleToggle}"/>
                    <Button Content="+" Width="26" Height="24" Margin="2,0,2,0" FontSize="14" FontWeight="Bold"
                            ToolTip="将当前内容保存为预设" Click="AddPolishPreset_Click"
                            IsEnabled="{Binding IsChecked, ElementName=PolishStyleToggle}"/>
                    <Button Content="−" Width="26" Height="24" FontSize="14" FontWeight="Bold"
                            ToolTip="删除选中预设" Click="RemovePolishPreset_Click"
                            IsEnabled="{Binding IsChecked, ElementName=PolishStyleToggle}"/>
                </StackPanel>
                <TextBox x:Name="PolishStyleTextBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="12" Padding="4" BorderBrush="#DDD"
                         Margin="0,0,0,6"
                         IsEnabled="{Binding IsChecked, ElementName=PolishStyleToggle}"/>

                <!-- 章节选择器 -->
                <Expander x:Name="ChapterSelectorExpander" Header="上下文章节（勾选要让AI读取的章节）"
                          IsExpanded="False" Margin="0,0,0,6" FontSize="12" FontWeight="Bold" Foreground="#555">
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="ChapterListBox" Height="120"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 BorderBrush="#DDD" FontSize="12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Content="{Binding Title}" Margin="2,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                            <Button Content="全选" Click="SelectAllChapters_Click"
                                    Width="45" Padding="4,2" FontSize="11" Margin="0,0,4,0"/>
                            <Button Content="全不选" Click="DeselectAllChapters_Click"
                                    Width="50" Padding="4,2" FontSize="11"/>
                        </WrapPanel>
                    </Grid>
                </Expander>

                <!-- 要求/输入 -->
                <TextBlock Text="要求 / 输入" FontWeight="Bold" Margin="0,0,0,3" FontSize="13"/>
                <TextBox x:Name="AiInputTextBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="13" Padding="4" BorderBrush="#DDD"/>

                <!-- AI回复 -->
                <TextBlock Text="AI 回复" FontWeight="Bold" Margin="0,8,0,3" FontSize="13"/>
                <TextBox x:Name="AiResultTextBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="13" Padding="4" BorderBrush="#DDD"
                         IsReadOnly="True" Background="#F5F5F5"/>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="复制" Click="CopyAiResult_Click"
                            Width="55" Margin="0,0,4,0" Padding="4,2" FontSize="12"/>
                    <Button x:Name="ApplyToContextBtn" Content="应用到 ▾" Click="ApplyToContext_Click"
                            Width="75" Margin="0,0,4,0" Padding="4,2" FontSize="12"/>
                    <Button x:Name="StopAiBtn" Content="⏹ 停止" Click="StopAi_Click"
                            Width="65" Padding="4,2" FontSize="12" Foreground="White"
                            Background="#E53935" BorderBrush="#C62828"
                            Visibility="Collapsed"/>
                </WrapPanel>

                <Separator Margin="0,10"/>

                <!-- AI 记忆 -->
                <TextBlock Text="AI 记忆（自动积累的写作经验）" FontWeight="Bold" Margin="0,0,0,6" FontSize="13"/>
                <Expander x:Name="MemoryExpander" Header="查看/编辑记忆" IsExpanded="False"
                          Margin="0,0,0,4" FontSize="12" FontWeight="Bold" Foreground="#555">
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="MemoryTb" Height="120" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="12" Padding="4" BorderBrush="#DDD"/>
                        <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                            <Button Content="保存修改" Click="SaveMemory_Click"
                                    Width="65" Padding="4,2" FontSize="12" Margin="0,0,4,0"/>
                            <Button Content="清空记忆" Click="ClearMemory_Click"
                                    Width="65" Padding="4,2" FontSize="12"/>
                        </WrapPanel>
                    </Grid>
                </Expander>

                <Separator Margin="0,6"/>

                <!-- 上下文设定（常驻，可折叠） -->
                <TextBlock Text="AI上下文设定（AI将参考以下内容）" FontWeight="Bold" Margin="0,0,0,6" FontSize="13"/>

                <Expander x:Name="FullOutlineExpander" Header="全文大纲" IsExpanded="False"
                          Margin="0,0,0,4" FontSize="12" FontWeight="Bold" Foreground="#555">
                    <TextBox x:Name="FullOutlineTextBox" Height="80" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="12" Padding="4" BorderBrush="#DDD" Margin="0,4,0,0"/>
                </Expander>

                <Expander x:Name="ChapterOutlineExpander" Header="章节大纲" IsExpanded="False"
                          Margin="0,0,0,4" FontSize="12" FontWeight="Bold" Foreground="#555">
                    <TextBox x:Name="ChapterOutlineTextBox" Height="80" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="12" Padding="4" BorderBrush="#DDD" Margin="0,4,0,0"/>
                </Expander>

                <Expander x:Name="CharacterSettingsExpander" Header="主要人物设定" IsExpanded="False"
                          Margin="0,0,0,4" FontSize="12" FontWeight="Bold" Foreground="#555">
                    <TextBox x:Name="CharacterSettingsTextBox" Height="80" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="12" Padding="4" BorderBrush="#DDD" Margin="0,4,0,0"/>
                </Expander>

                <Expander x:Name="BackgroundSettingsExpander" Header="主要背景设定" IsExpanded="False"
                          Margin="0,0,0,4" FontSize="12" FontWeight="Bold" Foreground="#555">
                    <TextBox x:Name="BackgroundSettingsTextBox" Height="80" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="12" Padding="4" BorderBrush="#DDD" Margin="0,4,0,0"/>
                </Expander>

                <Expander x:Name="WritingStyleExp" Header="文风设定" IsExpanded="False"
                          Margin="0,0,0,4" FontSize="12" FontWeight="Bold" Foreground="#555">
                    <TextBox x:Name="WritingStyleTb" Height="80" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="12" Padding="4" BorderBrush="#DDD" Margin="0,4,0,0"/>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
