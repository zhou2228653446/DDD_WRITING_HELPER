<Window x:Class="编辑器.NovelScaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择小说规模" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请选择小说规模，AI 将据此生成合适的大纲："
                   FontSize="14" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <ListBox x:Name="ScaleListBox" Grid.Row="1" FontSize="13"
                 SelectionChanged="ScaleListBox_SelectionChanged">
            <ListBoxItem Tag="short" IsSelected="True">
                <StackPanel Margin="4">
                    <TextBlock Text="📝 短篇小说" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="1~5万字 · 5~15章 · 单线叙事" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="medium">
                <StackPanel Margin="4">
                    <TextBlock Text="📖 中篇小说" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="5~20万字 · 15~40章 · 双线叙事" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="long">
                <StackPanel Margin="4">
                    <TextBlock Text="📚 长篇小说" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="20~50万字 · 40~100章 · 多线叙事" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="extralong">
                <StackPanel Margin="4">
                    <TextBlock Text="🏰 超长篇小说" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="50万字+ · 100章+ · 宏大世界观" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="75" Height="28" FontSize="13"
                    IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="跳过" Width="75" Height="28" FontSize="13"
                    IsCancel="True" Click="Skip_Click"/>
        </StackPanel>
    </Grid>
</Window>
