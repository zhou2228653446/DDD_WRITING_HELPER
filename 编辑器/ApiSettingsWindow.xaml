<hc:Window x:Class="编辑器.ApiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="AI设置" Height="600" Width="800"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" SizeToContent="Height">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标签切换 -->
        <hc:TabControl x:Name="ModeTabControl" Grid.Row="0" SelectionChanged="ModeTabControl_SelectionChanged">
            <!-- 表单编辑 -->
            <hc:TabItem Header="表单编辑">
                <Grid Margin="5" Height="468">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 配置方案选择 -->
                    <TextBlock Grid.Row="0" Text="配置方案" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <hc:ComboBox x:Name="ProfileComboBox" Grid.Column="0" Margin="0,0,6,0"
                                  SelectionChanged="ProfileComboBox_SelectionChanged"/>
                        <Button Name="NewProfileBtn" Grid.Column="1" Content="+ 新建" Width="70" Margin="0,0,4,0"
                                Click="NewProfile_Click"/>
                        <Button Name="SaveProfileBtn" Grid.Column="2" Content="覆盖保存" Width="80" Margin="0,0,4,0"
                                Click="SaveProfile_Click"/>
                        <Button Name="DeleteProfileBtn" Grid.Column="3" Content="删除" Width="60"
                                Click="DeleteProfile_Click"/>
                    </Grid>

                    <!-- AI 服务商：选中即自动填好地址 / 协议 / 认证方式 / 常用模型 -->
                    <TextBlock Grid.Row="2" Text="AI 服务商" FontWeight="Bold" Margin="0,0,0,5"/>
                    <hc:ComboBox x:Name="ProviderComboBox" Grid.Row="3" Margin="0,0,0,6"
                              SelectionChanged="ProviderComboBox_SelectionChanged"/>

                    <!-- 该服务商的接入参数速览（协议 / 认证 / 地址申请入口） -->
                    <Border Grid.Row="4" Margin="0,0,0,10" Padding="10,6"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Background="{DynamicResource Brush.SubtleBg}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProviderHintText" Grid.Column="0"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <Button x:Name="ProviderKeyBtn" Grid.Column="1" Margin="10,0,0,0"
                                    Content="获取 API Key" Height="26" Padding="10,0" FontSize="12"
                                    VerticalAlignment="Center"
                                    Click="OpenProviderConsole_Click"/>
                        </Grid>
                    </Border>

                    <!-- API URL -->
                    <TextBlock Grid.Row="5" Text="API 地址" FontWeight="Bold" Margin="0,0,0,5"/>
                    <hc:TextBox x:Name="ApiUrlTextBox" Grid.Row="6" Margin="0,0,0,8" FontSize="13"
                                TextChanged="ApiUrlTextBox_TextChanged"/>

                    <!-- Model：左边自由输入，中间拉取真实清单，右边从清单里挑 -->
                    <Grid Grid.Row="7" Margin="0,0,0,5">
                        <TextBlock Text="模型名称" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ModelStatusText" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                            <Button x:Name="ShowAllModelsBtn" Content="显示全部" FontSize="11"
                                    Height="20" Padding="8,0" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="ShowAllModels_Click"
                                    ToolTip="默认把 embedding / 语音 / 图片模型排在列表末尾并折叠"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="8" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <hc:TextBox x:Name="ModelTextBox" Grid.Column="0" Margin="0,0,6,0" FontSize="13"
                                    TextChanged="ModelTextBox_TextChanged"/>
                        <Button x:Name="FetchModelsBtn" Grid.Column="1" Content="拉取列表"
                                Width="82" Height="30" Margin="0,0,6,0" FontSize="12"
                                Click="FetchModels_Click"
                                ToolTip="向服务商查询当前真实可用的模型名（内置型号表可能已过期，以拉取结果为准）"/>
                        <hc:ComboBox x:Name="ModelPresetComboBox" Grid.Column="2" Width="190"
                                     hc:InfoElement.Placeholder="可用型号"
                                     SelectionChanged="ModelPresetComboBox_SelectionChanged"/>
                    </Grid>

                    <!-- 认证方式（留空=自动） + API Key -->
                    <Grid Grid.Row="9" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="认证方式" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="API Key" FontWeight="Bold"/>
                    </Grid>
                    <Grid Grid.Row="10" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <hc:ComboBox x:Name="AuthComboBox" Grid.Column="0" Margin="0,0,6,0"
                                     SelectionChanged="AuthComboBox_SelectionChanged"/>
                        <hc:PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="1" FontSize="13"/>
                    </Grid>

                    <!-- 按钮 -->
                    <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="TestButton" Content="测试连接" Width="100" Height="32" Margin="0,0,10,0"
                                Click="TestConnection_Click"/>
                        <Button Content="确定" Width="80" Height="32" Margin="0,0,10,0"
                                Click="OkButton_Click" IsDefault="True"/>
                        <Button Content="取消" Width="80" Height="32" Click="CancelButton_Click" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </hc:TabItem>

            <!-- JSON 编辑 -->
            <hc:TabItem x:Name="JsonTabItem" Header="JSON编辑">
                <Grid Margin="5" Height="430">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="直接编辑 api_profiles.json 配置文件" FontWeight="Bold" Margin="0,0,0,6"/>

                    <hc:TextBox x:Name="JsonEditorTextBox" Grid.Row="1"
                             FontFamily="Consolas" FontSize="13"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             Padding="8"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock x:Name="JsonValidationText" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="13"/>
                        <Button Content="格式化" Width="80" Height="32" Margin="0,0,8,0"
                                Click="FormatJson_Click"/>
                        <Button Content="保存JSON并刷新" Width="130" Height="32" Margin="0,0,8,0"
                                Click="SaveJson_Click" Background="{DynamicResource Brush.Success}" Foreground="{DynamicResource Brush.TextOnAccent}"/>
                        <Button Content="取消" Width="80" Height="32"
                                Click="CancelButton_Click" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </hc:TabItem>

            <!-- 系统提示词 -->
            <hc:TabItem x:Name="PromptTabItem" Header="系统提示词">
                <Grid Margin="5" Height="468">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ============ 方案栏：切换 小说/论文/公文/通用 及自定义方案 ============ -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="168"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="当前方案" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="2,0,8,0"/>

                        <hc:ComboBox x:Name="PresetComboBox" Grid.Column="1" Height="30"
                                     VerticalAlignment="Center"
                                     SelectionChanged="PresetComboBox_SelectionChanged"/>

                        <TextBlock x:Name="PresetDescText" Grid.Column="2"
                                   VerticalAlignment="Center" Margin="12,0"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="另存为副本" Height="28" Padding="10,0"
                                    Click="DuplicatePreset_Click"
                                    ToolTip="把当前方案另存为一个可以自由改动的自定义方案，并切换过去"/>
                            <Button x:Name="RenamePresetBtn" Content="重命名" Height="28" Padding="10,0"
                                    Margin="6,0,0,0" Click="RenamePreset_Click"
                                    ToolTip="只能重命名自定义方案；内置方案请用「另存为副本」"/>
                            <Button x:Name="DeletePresetBtn" Content="删除" Height="28" Padding="10,0"
                                    Margin="6,0,0,0" Click="DeletePreset_Click"
                                    ToolTip="只能删除自定义方案；内置方案不可删除"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：条目列表 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="提示词条目" FontWeight="Bold" Margin="2,0,0,6"/>

                        <ListBox x:Name="PromptListBox" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ListBoxItem.Card}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="PromptListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 单行紧凑排版：12 条能一屏放下，不必滚动 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Entry.Group}"
                                                   FontSize="10" Width="44" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Entry.Title}" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground,
                                                       RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        <!-- 已改过默认值的标记 -->
                                        <TextBlock Grid.Column="2" Text="&#xE70F;" FontSize="11"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   FontFamily="{StaticResource Font.Icon}"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   ToolTip="已自定义，不再跟随内置默认">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 右：编辑器 -->
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PromptTitleText" Grid.Column="0" FontWeight="Bold"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="ResetPromptBtn" Grid.Column="1" Content="恢复本项默认"
                                    Height="26" Padding="10,0" Click="ResetPrompt_Click"
                                    ToolTip="把这一条恢复成内置默认文本（改动在点保存后才落盘）"/>
                        </Grid>

                        <TextBlock x:Name="PromptDescText" Grid.Row="1" TextWrapping="Wrap"
                                   FontSize="11" Margin="0,4,0,6"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <TextBox x:Name="PromptEditorTextBox" Grid.Row="2"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12.5"
                                 Padding="8"
                                 Background="{DynamicResource Brush.InputBg}"
                                 Foreground="{DynamicResource Brush.Text}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"/>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="全部恢复默认" Height="32" Padding="12,0"
                                    Click="ResetAllPrompts_Click"
                                    ToolTip="清空所有自定义，全部回到内置文本（同样要点保存才落盘）"/>

                            <TextBlock x:Name="PromptStatusText" Grid.Column="1"
                                       VerticalAlignment="Center" Margin="12,0"
                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>

                            <Button Grid.Column="2" Content="取消" Width="80" Height="32" Margin="0,0,8,0"
                                    Click="CancelButton_Click" IsCancel="True"/>
                            <Button Grid.Column="3" Content="保存提示词" Width="110" Height="32"
                                    Style="{StaticResource Btn.Primary}"
                                    Click="SavePrompts_Click"/>
                        </Grid>
                    </Grid>
                    </Grid>
                </Grid>
            </hc:TabItem>
        </hc:TabControl>
    </Grid>
</hc:Window>
