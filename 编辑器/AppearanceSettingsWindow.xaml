<hc:Window x:Class="编辑器.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="外观设置" Height="720" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" SizeToContent="Height"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 配色 -->
        <GroupBox Grid.Row="0" Header="配色" Margin="0,0,0,12" Padding="8">
            <ListBox x:Name="PresetListBox" Height="132"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="PresetListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="0,0,0,4"
                                Background="{DynamicResource Brush.Panel}"
                                CornerRadius="{StaticResource Radius.Md}" BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 色块预览：面板底 / 编辑区 / 强调色 -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="3"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0.5"
                                            Background="{Binding PanelBgBrush}"
                                            ToolTip="面板底色"/>
                                    <Border Width="22" Height="22" CornerRadius="3" Margin="4,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0.5"
                                            Background="{Binding EditorBgBrush}"
                                            ToolTip="编辑区背景"/>
                                    <Border Width="22" Height="22" CornerRadius="3" Margin="4,0,0,0"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0.5"
                                            Background="{Binding AccentColorBrush}"
                                            ToolTip="强调色"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                               FontSize="{StaticResource FontSize.Subtitle}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSize.Small}"
                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- 材质（与配色独立，任意组合） -->
        <GroupBox Grid.Row="1" Header="材质" Margin="0,0,0,12" Padding="8">
            <StackPanel>
                <ListBox x:Name="MaterialListBox" Height="150"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="MaterialListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" Margin="0,0,0,4"
                                    Background="{DynamicResource Brush.Panel}"
                                    CornerRadius="{StaticResource Radius.Md}" BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 材质预览：用当前选中的配色底色渲染这一小块 -->
                                    <Border Grid.Column="0" Width="60" Height="38" CornerRadius="4"
                                            Margin="0,0,12,0" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0.5"
                                            Background="{Binding Preview}"
                                            ToolTip="当前配色下的质感预览"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"
                                                   FontSize="{StaticResource FontSize.Subtitle}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSize.Small}"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="材质强度" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Body}"/>
                    <Slider Grid.Column="1" x:Name="IntensitySlider" Minimum="0" Maximum="2"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="IntensitySlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" x:Name="IntensityText" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </Grid>

                <TextBlock Text="0 = 完全关掉质感（等同纯色），1 = 材质调好的默认观感，2 = 加倍。颗粒太重会显脏，建议 0.6～1.4。"
                           TextWrapping="Wrap" FontSize="{StaticResource FontSize.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 自定义背景图片 -->
        <GroupBox Grid.Row="2" Header="自定义背景图片" Margin="0,0,0,12" Padding="8">
            <StackPanel>
                <CheckBox x:Name="EnableBgCheckBox" Content="启用自定义图片作为窗口背景"
                          FontSize="{StaticResource FontSize.Body}" Margin="0,0,0,8"
                          Checked="EnableBg_Changed" Unchecked="EnableBg_Changed"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <hc:TextBox x:Name="BgPathTextBox" Grid.Column="0"
                             FontSize="{StaticResource FontSize.Small}" Padding="6" IsReadOnly="True"
                             Background="{DynamicResource Brush.SubtleBg}"
                             Foreground="{DynamicResource Brush.Text}"
                             BorderBrush="{DynamicResource Brush.Border}"/>
                    <Button Grid.Column="1" x:Name="BrowseBgBtn" Style="{StaticResource Btn.Ghost}"
                            Content="浏览..." Margin="6,0,0,0"
                            Click="BrowseBg_Click"/>
                </Grid>
                <Button x:Name="RemoveBgBtn" Style="{StaticResource Btn.Ghost}"
                        Content="移除背景图片" HorizontalAlignment="Left" IsEnabled="False"
                        Click="RemoveBg_Click"/>
                <TextBlock Text="毛玻璃 / 液态玻璃这类透光材质，配上背景图效果最明显——透出来的就是真实画面。"
                           FontSize="{StaticResource FontSize.Caption}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 提示 -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.SubtleBg}"
                CornerRadius="{StaticResource Radius.Md}" Padding="10" Margin="0,0,0,12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <TextBlock Text="配色与材质是两个独立维度，可任意组合。背景图片仅作为窗口氛围装饰，不会影响编辑区可读性。"
                       TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}"/>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{StaticResource Btn.Primary}" Width="84"
                    Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="取消" Style="{StaticResource Btn.Ghost}" Width="84"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</hc:Window>
