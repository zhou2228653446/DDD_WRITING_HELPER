<hc:Window x:Class="编辑器.ExitConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="退出" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Ui}"
        TextElement.Foreground="{DynamicResource Brush.Text}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="确认要退出吗？"
                   FontSize="{StaticResource FontSize.Title}" FontWeight="SemiBold"/>

        <!-- 保存选项：无项目时代码隐藏此行 -->
        <StackPanel x:Name="SavePanel" Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="SaveQuestionText" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSize.Body}"
                       Text="是否保存项目的更改？"/>
        </StackPanel>

        <!-- 主页 / 仓库：常驻在退出确认里 -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,12"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="⭐ 觉得这款写作助手好用？"
                           FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="项目完全免费、开源、无广告，去 GitHub 点个 Star 就是最大的支持，也能让更多写作者发现它。"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="仓库" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="RepoText" Grid.Column="1" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Small}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="复制"
                            Click="CopyRepo_Click"/>
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HomeLabel" Grid.Column="0" Text="主页" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HomeText" Grid.Column="1" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize.Small}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button x:Name="OpenHomeBtn" Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="复制"
                            Click="CopyHome_Click"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Btn.Ghost}" Content="去 GitHub 点 Star ⭐"
                            Click="OpenGithub_Click"/>
                    <Button Style="{StaticResource Btn.Ghost}" Content="打开主页" Margin="8,0,0,0"
                            Click="OpenHome_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveExitBtn" Style="{StaticResource Btn.Primary}"
                    Content="保存并退出" Click="SaveExit_Click"/>
            <Button x:Name="ExitBtn" Style="{StaticResource Btn.Ghost}" Content="直接退出"
                    Margin="8,0,0,0" Click="ExitOnly_Click"/>
            <Button Style="{StaticResource Btn.Ghost}" Content="取消" Margin="8,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</hc:Window>
